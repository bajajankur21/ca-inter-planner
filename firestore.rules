rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per Google account, written by js/sync.js. Only that account can read or write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'rev', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.rev is string
        && request.resource.data.updatedAt is int;
    }
    // Everything else is closed.
  }
}
